```{r enrichR}
library(enrichR)

#Define the enrichr databases to test
dbs <- c('GO_Biological_Process_2023','GO_Cellular_Component_2023','GO_Molecular_Function_2023')

#Split gene symbols into separate lists
geneInfoK_glial_lists <- split(geneInfoK_glial$geneSymbol, geneInfoK_glial$moduleColor)

#enrichR on all modules in the network
enrich_results_glia <- lapply(geneInfoK_glial_lists, function(genes) {
  enrichr(genes, dbs)
})

#Extract enrichment results for the blue module
enrich_blue <- enrich_results_glia$blue

enrich_blue_BP <- enrich_blue[["GO_Biological_Process_2023"]]
