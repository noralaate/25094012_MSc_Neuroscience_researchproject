```{r QC pre-normalization}

champ.QC(resultsDir = "./name_of_file/", beta= myLoad$beta, densityPlot = TRUE, 
         mdsPlot = TRUE, dendrogram = TRUE, pheno = myLoad$pd$Sample_Group)

```

```{r Normalization with BMIQ}

myNorm <- champ.norm(beta=myLoad$beta,
                     rgSet=myLoad$rgSet,
                     mset=myLoad$mset,
                     resultsDir="./name_of_file/",
                     method="BMIQ",
                     plotBMIQ=TRUE,
                     arraytype="EPIC",
                     cores=1)
save(myNorm, file = "myNorm.RData")

```

```{r QC post-normalization}

champ.QC(resultsDir = "./name_of_file/", beta= myNorm, densityPlot = TRUE, 
         mdsPlot = TRUE, dendrogram = TRUE, pheno = myLoad$pd$Sample_Group)

```

