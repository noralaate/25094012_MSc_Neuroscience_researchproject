```{r DGE list}
library(edgeR)
library(limma)

counts <- as.matrix(seq_data2)
head(counts)

#Digital gene expression list

d0 <- DGEList(counts)

d0 <- calcNormFactors(d0)
d0

cutoff <- 1
drop <- which(apply(cpm(d0), 1, max) < cutoff)
d <- d0[-drop,]
dim(d) # number of genes left

#For coloring in plotMDS
colData$Sample_Group <- paste("Null")
for(i in 1:nrow(colData)){
  print(i)
  if(colData$Subtype_Group1[i] == "CTRL"){
    colData$Sample_Group[i] <- paste("1")
  }
  else if(colData$Subtype_Group1[i] == "FTLD-TDPA" | colData$Subtype_Group1[i] == "FTLD-TDPC"){
    colData$Sample_Group[i] <- paste("2")
  }
  else if(colData$Subtype_Group1[i] == "AD"){
    colData$Sample_Group[i] <- paste("3")
  }
}

#Order for right color in plotMDS
colData_ordered <- colData[colnames(d), ]

#plot
plotMDS(d, col =colData_ordered$Sample_Group)
title(main = "MDS Plot of samples before exclusion")

#Removing outliers
samples_to_exclude <- c("FTLD18_G")
colData_ordered <- colData_ordered[!(rownames(colData_ordered) %in% samples_to_exclude), ]
d <- d[, !(colnames(d) %in% samples_to_exclude)]
save(colData_ordered, file="colData_ordered.RData")
save(d, file="d.RData")

plotMDS(d, col =colData_ordered$Sample_Group)
title(main = "MDS Plot of samples after exclusion, glia")
```

