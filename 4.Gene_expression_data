```{r RNAseq data}
#Read in the count data, and transform to data frame from tibble
FTLDRNAseq <- genes_counts_FTLD_sorted
FTLDRNAseq <- as.data.frame(FTLDRNAseq)

#Convert gene names (column 1) into row names
rownames(FTLDRNAseq) <- FTLDRNAseq$gene_name
FTLDRNAseq <- FTLDRNAseq[,-c(1)]

#Making new dataframe with only neuronal or glial samples
columns_glial <- grep("G", names(FTLDRNAseq)) #or "N" for neuronal samples
FTLDRNAseq_glial <- FTLDRNAseq[, columns_glial]
save(FTLDRNAseq_glial, file="FTLDRNAseq_glial.RData")  

#Sample sheet
SampleSheet <- read.csv("SampleSheet_G2_final.csv" )

overlap_samples <- SampleSheet$Pool_ID
valid_samples <- intersect(overlap_samples, colnames(FTLDRNAseq_glial))

#Extracting columns from FTLDseq_neuronal that are in overlap samples
seq_data1 <- as.matrix(FTLDRNAseq_glial[valid_samples])
seq_data <- as.data.frame(t(seq_data1)) 
seq_data$id <- rownames(seq_data) 

seq_data <- merge(seq_data, SampleSheet, by.x=c("id"), by.y=c("Pool_ID"), keep.all=F) 
rownames(seq_data) <- seq_data$Sample_Name

seq_data2 <- as.data.frame(t(seq_data[,c(2:56982)]))
  
save(seq_data2_glial, file="seq_data2_glial_july.RData")
save(yAdj, file="yAdj_glia.RData")

#Create sample metadata
colData <- SampleSheet
rownames(colData) <- colData$Sample_Name

