```{r Model matrix}
library(tidyverse)

age <- as.numeric(colData_ordered$Age)
pmi <- as.numeric(colData_ordered$PMI_min)

#Gathering all FTLD subtypes to one
colData_ordered$Sample_Group_new <- seq_data[rownames(colData_ordered), "Sample_Group"]
colData_ordered <- colData_ordered %>%
  mutate(Sample_Group_new = if_else(str_detect(Sample_Group_new, "FTLD"), 
                                    "FTLD_G", 
                                    Sample_Group_new))

group <- colData_ordered$Sample_Group_new
sex <- as.factor(colData_ordered$Sex)

#Regression model
mm <- model.matrix(~0 + group + age + sex + pmi) 
#Transform count data using coom and estimate mean-variance relationship
y <- voom(d, mm, plot = T)
title(sub="Glial")

#Fit linear model
