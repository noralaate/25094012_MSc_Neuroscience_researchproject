boxplot_genes_multiple <- function(df1, df2, genename) {
  
  #Data frame name as text
  df_name1 <- deparse(substitute(df1))
  
  #Naming plot based on data frame
  title_text1 <- if(grepl("neuronal", df_name1, ignore.case = TRUE)) {
    "Neuronal fraction:"
  } else {
    "Glial fraction:"  
  }
  
  #Data frame for use in plot
  plot_data1 <- df1 %>%
    filter(rownames(df1) == genename) %>%
    pivot_longer(
      cols = starts_with(c("CTRL", "FTLD")),
      names_to = "Group",        # create a group where the sample names get collected
      names_pattern = "(CTRL|FTLD)", # looking for CTRL or FTLD in the name
      values_to = "Expression")
  
  #Box plot
  plot1 <- ggplot(plot_data1, aes(x = Group, y = Expression, color = Group)) + 
    geom_boxplot(outlier.shape = NA, fill= NA) +
    geom_jitter(width = 0.2, alpha = 0.4, size = 2) + 
    theme_classic() + 
    labs(x = "group", y = "Transcript expression", title = title_text1) +
    theme(
      plot.title = element_text(
        hjust = 0.5,            
        size = 14             
      )
    )
  
  #Data frame name as text
  df_name2 <- deparse(substitute(df2))
  
  #Naming plot based on data frame
  title_text2 <- if(grepl("neuronal", df_name2, ignore.case = TRUE)) {
    "Neuronal fraction:"
  } else {
    "Glial fraction:"  
  }
  
  #Data frame for use in plot
