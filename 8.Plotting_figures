fishers_plot <- function(fisher_df){
  
  df_name <- deparse(substitute(fisher_df))
  
  fisher_df <- fisher_df[order(fisher_df$Fisher_OR, decreasing = TRUE), ]
  
  fisher_df$Fisher_p_val <- as.numeric(fisher_df$Fisher_p_val)
  fisher_df$Fisher_OR <- as.numeric(fisher_df$Fisher_OR)
  
  fisher_df$significance <- "none"
  fisher_df$significance[fisher_df$Fisher_p_val > 0.5] <- "P Value: > 0.50"
  fisher_df$significance[fisher_df$Fisher_p_val > 0.25 & fisher_df$Fisher_p_val < 0.5 ] <- "P Value: 0.25 - 0.50"
  fisher_df$significance[fisher_df$Fisher_p_val > 0.05 & fisher_df$Fisher_p_val < 0.25 ] <- "P Value: 0.05 - 0.25"
  fisher_df$significance[fisher_df$Fisher_p_val < 0.05] <- "P Value: < 0.05"
  
  
  fisher_plot <- ggplot(fisher_df, aes(x= reorder(Fisher_module, Fisher_OR), y=Fisher_OR, fill = significance)) +
  geom_bar(stat = "identity", width = 0.8) +
  geom_hline(yintercept = 1, linetype = "dashed") +
